{
  "name": "dash-threshold-identity",
  "version": "0.1.0",
  "description": "Threshold (t-of-n) BLS keys for Dash Platform identities: remote DKG ceremonies, transition proposals, threshold signing.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dti": "bin/dti.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "relay:dev": "wrangler dev --config relay/wrangler.toml",
    "web:build": "node web/build.mjs",
    "web:dev": "npm run web:build && wrangler dev --config web/wrangler.toml",
    "web:deploy": "npm run web:build && wrangler deploy --config web/wrangler.toml"
  },
  "dependencies": {
    "@dashevo/dashcore-lib": "0.26.1",
    "@dashevo/evo-sdk": "5.0.3",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "assert": "2.1.0",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "events": "3.3.0",
    "url": "0.11.4",
    "util": "0.12.5",
    "wrangler": "4.165.0"
  },
  "imports": {
    "#storage": {
      "browser": "./src/storage/memory.mjs",
      "default": "./src/storage/node.mjs"
    }
  }
}
